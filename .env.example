# Root variables for docker-compose.yml. Copy to .env and adjust.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bizstruct

# Shared secret: the api expects it, the ml worker sends it as x-api-key.
INTERNAL_API_KEY=change-me-too

# Queue name shared by the api (producer) and the ml worker (consumer). No default on purpose.
SERVICE_BUS_QUEUE_NAME=generation-tasks

# Host ports (all bound to 127.0.0.1).
DB_PORT=15432
API_PORT=18000
FE_PORT=3001
